# Supabase project (staging and production are SEPARATE projects)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# Used only by: patient sign-in (OTP), the message dispatcher job, the WhatsApp webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.goldencare.example
# Default branch timezone
APP_TIMEZONE=Africa/Cairo

# Messaging. "whatsapp" sends through the WhatsApp Cloud API; "dev" only logs (local development).
MESSAGING_MODE=whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Webhook: verify token you choose in the Meta dashboard + the app secret for HMAC signature checks
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Scheduler (e.g. Vercel Cron / Supabase cron) calls POST /api/jobs/dispatch with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# LOCAL DEVELOPMENT ONLY — shows the portal sign-in code on screen. Never set in staging or production.
# PORTAL_DEV_SHOW_OTP=true
