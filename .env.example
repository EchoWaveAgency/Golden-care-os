# Supabase project (staging and production are SEPARATE projects)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# Used only by: patient sign-in (OTP), the message dispatcher job, the WhatsApp webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.goldencare.example
# Default branch timezone
APP_TIMEZONE=Africa/Cairo

# Messaging. "whatsapp" sends through the WhatsApp Cloud API; "dev" only logs (local development).
MESSAGING_MODE=whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Webhook: verify token you choose in the Meta dashboard + the app secret for HMAC signature checks
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Scheduler (e.g. Vercel Cron / Supabase cron) calls POST /api/jobs/dispatch with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Online payments from the patient portal. "paymob" in production; "dev" = local simulator only; unset = disabled.
PAYMENTS_MODE=paymob
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
# HMAC secret from the Paymob dashboard; callbacks without a valid signature are rejected.
PAYMOB_HMAC_SECRET=
# PAYMOB_API_BASE=https://accept.paymob.com

# LOCAL DEVELOPMENT ONLY — shows the portal sign-in code on screen. Never set in staging or production.
# PORTAL_DEV_SHOW_OTP=true

# Patient care assistant (session 10)
# Voice calls (optional): Twilio account + a number that can call Egypt; PUBLIC_BASE_URL is the https URL Twilio calls back.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
CARE_VOICE_SECRET=
# TWILIO_VOICE=Google.ar-XA-Standard-A
# TWILIO_LANGUAGE=ar-EG
# AI understanding of free-text replies (optional; needs the clinic's approval and a data processing agreement)
# ANTHROPIC_API_KEY=
# CARE_LLM=on
# Psychological support hotline used in the self-harm message (confirm with the medical director)
CARE_CRISIS_LINE=16328
# Local development only — NEVER in production:
# CARE_SIMULATOR=on

# Electronic receipts / invoices (Egyptian Tax Authority). Leave unset until the ETA connector is certified with the clinic's credentials.
# ETA_CLIENT_ID=
# ETA_CLIENT_SECRET=
# Local development only — NEVER in production (simulator accepts every complete document with test ids):
# EINVOICE_MODE=dev

# Patient files (results, reports, photos): a PRIVATE Supabase Storage bucket. Create it in the dashboard (public: off).
FILES_BUCKET=patient-files
# Local development only — files are written to .localfiles/ (refused unless the database is on localhost):
# FILES_MODE=local
